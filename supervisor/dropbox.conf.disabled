[program:dropbox]
command=/usr/local/bin/dropboxd
autostart=false
autorestart=true
startsecs=5
stopasgroup=true
killasgroup=true
stdout_logfile=/config/logs/dropbox.log
stdout_logfile_maxbytes=5MB
stdout_logfile_backups=3
stderr_logfile=/config/logs/dropbox.err.log
stderr_logfile_maxbytes=5MB
stderr_logfile_backups=3
environment=HOME="/root",USER="root",LOGNAME="root",PATH="/root/.opencode/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
