#!/bin/bash
set -euo pipefail

export HOME=/root
export USER=root
export LOGNAME=root
export PATH=/root/.opencode/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}

mkdir -p /config/persist/root /config/logs /data/aiplayground /data/gitrepos /root/.ssh /run/sshd /var/log/supervisor

ln -sfn /data/aiplayground /root/aiplayground
ln -sfn /data/gitrepos /root/gitrepos
ln -sfn /opt/dropbox /root/.dropbox-dist

if [[ -d /config/persist/root ]]; then
  rsync -a /config/persist/root/ /root/ || true
fi

chmod 700 /root/.ssh 2>/dev/null || true
chmod 600 /root/.ssh/* 2>/dev/null || true

if [[ -n "${ROOT_PASSWORD:-}" ]]; then
  printf 'root:%s\n' "${ROOT_PASSWORD}" | chpasswd
fi

ssh-keygen -A >/dev/null 2>&1 || true

exec "$@"
