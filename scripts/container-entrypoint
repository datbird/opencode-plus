#!/bin/bash
set -euo pipefail

export HOME=/root
export USER=root
export LOGNAME=root
export PATH=/root/.opencode/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}
export OPENCODE_WORKSPACE_DIR="${OPENCODE_WORKSPACE_DIR:-/root/workspace}"
export OPENCODE_REPOS_DIR="${OPENCODE_REPOS_DIR:-/root/repos}"
export OPENCODE_PLUS_ENHANCEMENT_MODE="${OPENCODE_PLUS_ENHANCEMENT_MODE:-true}"
export OPENCODE_CF_AUTH_ENABLED="${OPENCODE_CF_AUTH_ENABLED:-false}"

mkdir -p /config/logs "$OPENCODE_WORKSPACE_DIR" "$OPENCODE_REPOS_DIR" /var/log/supervisor

case "${OPENCODE_PLUS_ENHANCEMENT_MODE}" in
  true|TRUE|1|yes|YES) export OPENCODE_PLUS_ENHANCEMENT_MODE=true ;;
  false|FALSE|0|no|NO|"") export OPENCODE_PLUS_ENHANCEMENT_MODE=false ;;
  *) echo "OPENCODE_PLUS_ENHANCEMENT_MODE must be true or false" >&2; exit 1 ;;
esac

if [[ "${OPENCODE_PLUS_ENHANCEMENT_MODE}" == "true" ]]; then
  mkdir -p /config/persist/root /root/.ssh /run/sshd

  if [[ ! -d /root/aiplayground || -L /root/aiplayground ]]; then
    ln -sfn "$OPENCODE_WORKSPACE_DIR" /root/aiplayground
  fi
  if [[ ! -d /root/gitrepos || -L /root/gitrepos ]]; then
    ln -sfn "$OPENCODE_REPOS_DIR" /root/gitrepos
  fi
  ln -sfn /opt/dropbox /root/.dropbox-dist

  if [[ -d /config/persist/root ]]; then
    rsync_excludes=()
    for mounted_state_path in \
      .local/share/opencode \
      .config/opencode \
      .cache/opencode; do
      if awk -v mount_point="/root/${mounted_state_path}" '$5 == mount_point { found = 1 } END { exit !found }' /proc/self/mountinfo; then
        rsync_excludes+=(--exclude="${mounted_state_path}/**")
      fi
    done
    rsync -a "${rsync_excludes[@]}" /config/persist/root/ /root/ || true
  fi

  chmod 700 /root/.ssh 2>/dev/null || true
  chmod 600 /root/.ssh/* 2>/dev/null || true
fi

if [[ "${OPENCODE_PLUS_ENHANCEMENT_MODE}" == "true" && -n "${ROOT_PASSWORD:-}" ]]; then
  printf 'root:%s\n' "${ROOT_PASSWORD}" | chpasswd
fi

write_gateway_env() {
  local env_file="/config/persist/opencode-cf-auth-proxy.env"
  local skip_aud="${CF_ACCESS_SKIP_AUD:-false}"
  local basic_user="${OPENCODE_BASIC_USER:-${OPENCODE_SERVER_USERNAME:-}}"
  local basic_password="${OPENCODE_BASIC_PASSWORD:-${OPENCODE_SERVER_PASSWORD:-}}"

  if [[ "${skip_aud}" != "true" && -z "${CF_ACCESS_AUD:-}" ]]; then
    echo "OPENCODE_CF_AUTH_ENABLED=true requires CF_ACCESS_AUD unless CF_ACCESS_SKIP_AUD=true" >&2
    exit 1
  fi
  if [[ -z "${ALLOWED_EMAILS:-}" ]]; then
    echo "OPENCODE_CF_AUTH_ENABLED=true requires ALLOWED_EMAILS" >&2
    exit 1
  fi
  if [[ -z "${OPENCODE_BASIC_AUTH_B64:-}" && ( -z "${basic_user}" || -z "${basic_password}" ) ]]; then
    echo "OPENCODE_CF_AUTH_ENABLED=true requires OPENCODE_BASIC_AUTH_B64 or OpenCode basic auth user/password" >&2
    exit 1
  fi

  {
    printf 'LISTEN_ADDR=%q\n' "${OPENCODE_CF_AUTH_LISTEN_ADDR:-0.0.0.0:4097}"
    printf 'UPSTREAM_URL=%q\n' "${OPENCODE_CF_AUTH_UPSTREAM_URL:-http://127.0.0.1:${OPENCODE_SERVER_PORT:-4096}}"
    printf 'CF_ACCESS_AUD=%q\n' "${CF_ACCESS_AUD:-}"
    printf 'CF_ACCESS_SKIP_AUD=%q\n' "${skip_aud}"
    printf 'TRUSTED_CF_ISSUER_SUFFIX=%q\n' "${TRUSTED_CF_ISSUER_SUFFIX:-.cloudflareaccess.com}"
    printf 'ALLOWED_EMAILS=%q\n' "${ALLOWED_EMAILS}"
    if [[ -n "${OPENCODE_BASIC_AUTH_B64:-}" ]]; then
      printf 'OPENCODE_BASIC_AUTH_B64=%q\n' "${OPENCODE_BASIC_AUTH_B64}"
    else
      printf 'OPENCODE_BASIC_USER=%q\n' "${basic_user}"
      printf 'OPENCODE_BASIC_PASSWORD=%q\n' "${basic_password}"
    fi
    printf 'OPENCODE_ROOT_REDIRECT_PATH=%q\n' "${OPENCODE_ROOT_REDIRECT_PATH:-/}"
    printf 'OPENCODE_PLUS_UI_ENABLED=%q\n' "${OPENCODE_PLUS_UI_ENABLED:-false}"
    printf 'OPENCODE_PLUS_UI_ASSET_DIR=%q\n' "${OPENCODE_PLUS_UI_ASSET_DIR:-/config/persist/opencode-plus-ui}"
    printf 'OPENCODE_PLUS_AUTH_STATE_FILE=%q\n' "${OPENCODE_PLUS_AUTH_STATE_FILE:-/config/persist/opencode-plus-auth-state.json}"
    printf 'OPENCODE_PLUS_QUOTA_URL=%q\n' "${OPENCODE_PLUS_QUOTA_URL:-http://127.0.0.1:18765/quota}"
    printf 'OPENCODE_PLUS_SECRETS_DIR=%q\n' "${OPENCODE_PLUS_SECRETS_DIR:-/config/persist/opencode-plus-secrets}"
    printf 'OPENCODE_PLUS_CONFIG_FILE=%q\n' "${OPENCODE_PLUS_CONFIG_FILE:-/config/persist/opencode-plus-config.json}"
    printf 'OPENCODE_CONFIG_FILE=%q\n' "${OPENCODE_CONFIG_FILE:-/root/aiplayground/opencode.json}"
  } > "${env_file}"
  chmod 600 "${env_file}" || true
}

case "${OPENCODE_CF_AUTH_ENABLED}" in
  true|TRUE|1|yes|YES)
    if [[ "${OPENCODE_PLUS_ENHANCEMENT_MODE}" != "true" ]]; then
      echo "OPENCODE_CF_AUTH_ENABLED=true requires OPENCODE_PLUS_ENHANCEMENT_MODE=true" >&2
      exit 1
    fi
    export OPENCODE_CF_AUTH_ENABLED=true
    write_gateway_env
    ;;
  false|FALSE|0|no|NO|"") export OPENCODE_CF_AUTH_ENABLED=false ;;
  *) echo "OPENCODE_CF_AUTH_ENABLED must be true or false" >&2; exit 1 ;;
esac

if [[ "${OPENCODE_PLUS_ENHANCEMENT_MODE}" == "true" ]]; then
  ssh-keygen -A >/dev/null 2>&1 || true

  plus_ui_asset_dir="${OPENCODE_PLUS_UI_ASSET_DIR:-/config/persist/opencode-plus-ui}"
  if [[ -d /opt/opencode-plus-ui ]]; then
    mkdir -p "${plus_ui_asset_dir}"
    rsync -a --ignore-existing /opt/opencode-plus-ui/ "${plus_ui_asset_dir}/" || true
  fi
fi

exec "$@"
